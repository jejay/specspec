{
  "name": "specspec-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone local SpecSpec graph UI for Linux and Windows",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "test:host": "npm run build && node test-host/run.cjs",
    "package": "npm run build && electron-packager . SpecSpec --out=release --overwrite --prune=true --ignore=\"^/(node_modules|test|test-host|scripts|release|[.]specspec-local|[.]vscode-test)(/|$)\""
  },
  "allowScripts": {
    "electron@44.6.0": true
  },
  "devDependencies": {
    "electron": "44.6.0",
    "@electron/packager": "20.3.0"
  }
}
