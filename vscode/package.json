{
  "name": "specspec-vscode",
  "displayName": "specspec-vscode",
  "description": "Connect intentions, revisable choices and implementation in versioned Markdown",
  "repository": { "type": "git", "url": "https://github.com/jejay/specspec.git", "directory": "vscode" },
  "homepage": "https://github.com/jejay/specspec",
  "bugs": { "url": "https://github.com/jejay/specspec/issues" },
  "version": "0.0.1",
  "publisher": "specspec-dev",
  "private": true,
  "license": "MIT",
  "icon": "media/app-icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": ["workspace"],
  "activationEvents": [
    "workspaceContains:.specspec/*.md"
  ],
  "capabilities": {
    "virtualWorkspaces": { "supported": false },
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "specspec.openGraph",
        "title": "specspec: Open Graph"
      },
      {
        "command": "specspec.compareRevisions",
        "title": "specspec: Compare Revisions",
        "icon": "$(git-compare)"
      },
      {
        "command": "specspec.selectProject",
        "title": "specspec: Select Project",
        "icon": "$(folder-opened)"
      }
    ],
    "configuration": {
      "title": "specspec",
      "properties": {
        "specspec.command": {
          "type": "string",
          "default": "specspec",
          "scope": "machine-overridable",
          "description": "Python CLI executable invoked directly."
        },
        "specspec.traceLoading": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Log loading phase durations and counts in the specspec output channel."
        },
        "specspec.pollIntervalMs": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 2147483647,
          "scope": "resource",
          "description": "Optional graph polling interval in milliseconds. 0 disables polling (default); file watchers remain enabled."
        },
        "specspec.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Argument prefix, such as [\"-m\", \"specspec\"]."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "specspec.graphEditor",
        "displayName": "specspec Graph",
        "selector": [
          { "filenamePattern": "**/.specspec/???????=.md" }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "specspec.compareRevisions",
          "when": "activeCustomEditorId == specspec.graphEditor",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "specspec.openGraph",
          "when": "explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p . && node scripts/build-webview.cjs",
    "watch": "node scripts/build-webview.cjs && tsc -w -p .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "test:host": "npm run compile && node test-host/run.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "node scripts/package.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vscode/vsce": "4.0.0",
    "@types/vscode": "^1.90.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0"
  }
}
