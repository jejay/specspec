{
  "version": "0.2.0",
  "configurations": [{
    "name": "Run SpecSpec Extension",
    "type": "extensionHost",
    "request": "launch",
    "args": [
      "--new-window",
      "--user-data-dir=${workspaceFolder}/../.vscode-test/dev-profile",
      "--extensionDevelopmentPath=${workspaceFolder}",
      "${workspaceFolder}/../specspec-dev.code-workspace"
    ],
    "outFiles": ["${workspaceFolder}/out/**/*.js"],
    "preLaunchTask": "compile",
    "env": {
      "SPECSPEC_PYTHON": "${workspaceFolder}/../.venv/bin/python"
    },
    "windows": {
      "env": {
        "SPECSPEC_PYTHON": "${workspaceFolder}/../.venv/Scripts/python.exe"
      }
    }
  }]
}
